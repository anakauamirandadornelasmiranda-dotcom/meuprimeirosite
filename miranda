
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Uma pergunta para você ❤️</title>

    <style>
        body {
            background: linear-gradient(135deg, #ff69b4, #ffb6c1);
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }

        .caixa {
            background: white;
            padding: 35px;
            border-radius: 20px;
            text-align: center;
            width: 80%;
            max-width: 350px;
            box-shadow: 0 5px 20px #0003;
        }

        h1 {
            color: #ff1493;
        }

        p {
            font-size: 20px;
        }

        button {
            padding: 12px 25px;
            border: none;
            border-radius: 10px;
            font-size: 18px;
            cursor: pointer;
            margin: 10px;
        }

        .sim {
            background: #ff1493;
            color: white;
        }

        .nao {
            background: #ddd;
            color: black;
        }
    </style>
</head>

<body>

    <div class="caixa">
        <h1>Uma pergunta para você ❤️</h1>

        <p>Você gosta de mim? 🥺</p>

        <button class="sim" onclick="responderSim()">
            SIM ❤️
        </button>

        <button class="nao" onclick="responderNao()">
            NÃO 😢
        </button>

        <h2 id="resposta"></h2>
    </div>

    <script>
        function responderSim() {
            document.getElementById("resposta").innerHTML =
                "Eu sabia! ❤️😍";
        }

        function responderNao() {
            document.getElementById("resposta").innerHTML =
                "Ahhh, vou ficar triste 😭💔";
        }
    </script>

</body>
</html>
